---
import Cover from './Cover.astro';
import { albumUrl, type Album } from '../lib/albums';

interface Props {
  albums: Album[];
}
const { albums } = Astro.props;
---

<ul class="grid">
  {
    albums.map((album, i) => (
      <li>
        <a href={albumUrl(album)}>
          <Cover
            album={album}
            widths={[240, 360, 480]}
            sizes="(min-width: 1100px) 200px, (min-width: 640px) 25vw, 45vw"
            loading={i < 6 ? 'eager' : 'lazy'}
          />
          <span class="title">{album.data.title}</span>
          <span class="artist">{album.data.artist}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 16px;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
      gap: 32px 24px;
    }
  }
  a {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  a :global(.cover) {
    transition: transform 0.15s ease;
  }
  a:hover :global(.cover) {
    transform: translateY(-3px) rotate(-0.6deg);
  }
  @media (prefers-reduced-motion: reduce) {
    a:hover :global(.cover) {
      transform: none;
    }
  }
  .title {
    display: block;
    margin-top: 10px;
    font-weight: 600;
    line-height: 1.3;
  }
  .artist {
    display: block;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
