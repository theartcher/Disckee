---
import { Image } from 'astro:assets';
import type { Album } from '../lib/albums';

interface Props {
  album: Album;
  sizes: string;
  widths: number[];
  loading?: 'lazy' | 'eager';
}
const { album, sizes, widths, loading = 'lazy' } = Astro.props;
const { cover, title, artist } = album.data;
---

{
  cover ? (
    <Image
      src={cover}
      alt={`Cover of ${title} by ${artist}`}
      widths={widths}
      sizes={sizes}
      format="webp"
      loading={loading}
      class="cover"
    />
  ) : (
    <div class="cover placeholder" role="img" aria-label={`No cover yet for ${title}`}>
      <span>{title}</span>
    </div>
  )
}

<style>
  .cover {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: var(--shadow);
    background: var(--placeholder);
  }
  .placeholder {
    display: grid;
    place-items: center;
    padding: 12%;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 3vw, 1.3rem);
    color: var(--muted);
    /* A faint disc, so an album without a cover still reads as a CD. */
    background:
      radial-gradient(circle, transparent 0 9%, var(--border) 9% 10%, transparent 10% 44%, var(--border) 44% 45%, transparent 45%),
      var(--placeholder);
  }
</style>
