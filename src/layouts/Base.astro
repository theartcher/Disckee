---
import 'antd/dist/reset.css';

interface Props {
  title?: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>{title ? `${title} · Disckee` : 'Disckee'}</title>
    <script is:inline>
      // Pick the theme before the page renders so it doesn't flash white in dark mode.
      try {
        const stored = localStorage.getItem('theme');
        document.documentElement.dataset.theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      } catch {}
    </script>
    <style is:global>
      /* Matches Ant Design's colorBgLayout, shown until the page has loaded. */
      html,
      body {
        background: #f5f5f5;
      }
      html[data-theme='dark'],
      html[data-theme='dark'] body {
        background: #000;
        color-scheme: dark;
      }
    </style>
  </head>
  <body>
    <slot />
    <noscript>Disckee needs JavaScript to show the collection.</noscript>
  </body>
</html>
