---
import 'antd/dist/reset.css';

interface Props {
  title?: string;
  /** Which home-screen app this page installs as: the site, or /add on its own. */
  app?: 'site' | 'add';
  /** The line search engines and link previews show under the title. */
  description?: string;
  /** A picture for link previews, like an album cover. Defaults to the app icon. */
  image?: string;
  /** Keep owners' tools and the 404 page out of search results. */
  noindex?: boolean;
}
const {
  title,
  app = 'site',
  description = "Disckee is Arthur and Marlou's CD collection and wishlist.",
  image,
  noindex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title ? `${title} · Disckee` : 'Disckee';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image ?? `${base}/icons/icon-512.png`, Astro.site).href;
// Tells Google the site's name is "Disckee", so results show it instead of the github.io address.
const siteData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Disckee',
  url: new URL(`${base}/`, Astro.site).href,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    <link rel="manifest" href={`${base}/${app === 'add' ? 'add' : 'manifest'}.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}/icons/apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-title" content={app === 'add' ? 'Add CD' : 'Disckee'} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="Disckee" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary" />
    {!title && <script type="application/ld+json" set:html={JSON.stringify(siteData)} />}
    <script is:inline>
      // Pick the theme before the page renders so it doesn't flash white in dark mode.
      try {
        const stored = localStorage.getItem('theme');
        document.documentElement.dataset.theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        // The hidden Helldivers theme (see Shell) is dark-based.
        if (localStorage.getItem('disckee:helldivers') === 'on') {
          document.documentElement.dataset.theme = 'dark';
          document.documentElement.dataset.skin = 'helldivers';
        }
      } catch {}
    </script>
    <style is:global>
      /* Matches Ant Design's colorBgLayout, shown until the page has loaded. */
      html,
      body {
        background: #f5f5f5;
      }
      html[data-theme='dark'],
      html[data-theme='dark'] body {
        background: #000;
        color-scheme: dark;
      }
      /* Stands in for the header until the page has loaded, so the first paint isn't an empty page
         and the content doesn't jump down when the real header arrives. Same height and colours as Shell's. */
      #boot-header {
        position: sticky;
        top: 0;
        height: 64px;
        background: #fff;
        border-bottom: 1px solid #f0f0f0;
      }
      html[data-theme='dark'] #boot-header {
        background: #141414;
        border-bottom-color: #303030;
      }
      html[data-skin='helldivers'],
      html[data-skin='helldivers'] body {
        background: #0b0c0e;
      }
      /* Helldivers headings shout, like the game's menus. */
      html[data-skin='helldivers'] :is(h1, h2, h3, h4) {
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      html[data-skin='helldivers'] #boot-header {
        background: #1b1c1e;
        border-bottom-color: #2c2d30;
      }
      body:has(.ant-layout) #boot-header {
        display: none;
      }
    </style>
  </head>
  <body>
    <div id="boot-header" aria-hidden="true"></div>
    <slot />
    <noscript>Disckee needs JavaScript to show the collection.</noscript>
  </body>
</html>
