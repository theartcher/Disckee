---
import { authUrl } from '../../lib/cms';
import { checkCmsFields } from '../../lib/cms-check';

// Fails the build if the CMS fields and the album schema have drifted apart.
checkCmsFields();

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// In dev the CMS always loads, for Sveltia's "Work with Local Repository" mode.
const enabled = Boolean(authUrl) || import.meta.env.DEV;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>Disckee admin</title>
    <style>
      #back {
        position: fixed;
        z-index: 1000;
        left: 12px;
        bottom: calc(12px + env(safe-area-inset-bottom));
        padding: 8px 14px;
        border-radius: 999px;
        font: 500 14px/1.2 system-ui, sans-serif;
        text-decoration: none;
        color: #fff;
        background: #1677ff;
        box-shadow: 0 2px 8px rgb(0 0 0 / 25%);
      }
    </style>
  </head>
  <body>
    {
      enabled ? (
        <>
          <a id="back" href={`${base}/`}>
            ← Back to site
          </a>
          <script src="../../lib/admin-init.ts"></script>
        </>
      ) : (
        <p style="font-family: system-ui, sans-serif; margin: 2rem">
          Sign-in isn't set up yet. See docs/SETUP.md in the repository.
        </p>
      )
    }
  </body>
</html>
