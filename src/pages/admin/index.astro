---
import { authUrl } from '../../lib/cms';
import { checkCmsFields } from '../../lib/cms-check';

// Fails the build if the CMS fields and the album schema have drifted apart.
checkCmsFields();

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// In dev the CMS always loads, for Sveltia's "Work with Local Repository" mode.
const enabled = Boolean(authUrl) || import.meta.env.DEV;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>Disckee admin</title>
    <style>
      #back {
        position: fixed;
        z-index: 1000;
        left: 12px;
        bottom: calc(12px + env(safe-area-inset-bottom));
        display: flex;
        gap: 8px;
      }
      #back a {
        /* Looks like an antd button, like the rest of the site. */
        padding: 7px 15px;
        border: 1px solid #1677ff;
        border-radius: 6px;
        font: 400 14px/1.5714 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        text-decoration: none;
        color: #fff;
        background: #1677ff;
        box-shadow: 0 2px 8px rgb(0 0 0 / 25%);
      }
      #back a.secondary {
        border-color: #d9d9d9;
        color: rgb(0 0 0 / 88%);
        background: #fff;
      }
      @media (prefers-color-scheme: dark) {
        #back a.secondary {
          border-color: #424242;
          color: rgb(255 255 255 / 85%);
          background: #141414;
        }
      }
    </style>
  </head>
  <body>
    {
      enabled ? (
        <>
          {/* Back to the site, or to /add for scanning the next CD after a save. */}
          <nav id="back">
            <a href={`${base}/`}>← Back to home</a>
            <a class="secondary" href={`${base}/add/`}>
              Back to scan
            </a>
          </nav>
          <script>
          import { init } from '@sveltia/cms';
          import { cmsConfig } from '../../lib/cms';

          init({ config: cmsConfig(new URL(import.meta.env.BASE_URL, location.origin).href) });
          </script>
        </>
      ) : (
        <p style="font-family: system-ui, sans-serif; margin: 2rem">
          Sign-in isn't set up yet. See docs/SETUP.md in the repository.
        </p>
      )
    }
  </body>
</html>
