---
import Base from '../layouts/Base.astro';
import AlbumListPage from '../components/AlbumListPage';
import { albumsByStatus, baseUrl, toCard } from '../lib/albums';

const albums = await Promise.all((await albumsByStatus('collection')).map(toCard));
---

<Base title="Collection">
  <AlbumListPage client:only="react" baseUrl={baseUrl} section="collection" title="Our collection" albums={albums} home />
</Base>
