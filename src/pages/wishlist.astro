---
import Base from '../layouts/Base.astro';
import AlbumGrid from '../components/AlbumGrid.astro';
import { albumsByStatus } from '../lib/albums';

// Basic grid for now; share links and the visitor intro come with #15.
const albums = await albumsByStatus('wishlist');
---

<Base title="Wishlist">
  <div class="intro">
    <h1>Wishlist</h1>
    <p>CDs we'd love to add to the rack.</p>
  </div>
  <AlbumGrid albums={albums} />
</Base>

<style>
  .intro {
    margin-bottom: 24px;
  }
  h1 {
    font-size: clamp(1.8rem, 6vw, 2.6rem);
  }
  p {
    margin: 6px 0 0;
    color: var(--muted);
  }
</style>
