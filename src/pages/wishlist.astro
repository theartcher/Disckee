---
import Base from '../layouts/Base.astro';
import AlbumListPage from '../components/AlbumListPage';
import { albumsByStatus, baseUrl, toCard } from '../lib/albums';

const albums = await Promise.all((await albumsByStatus('wishlist')).map(toCard));
// No online claims (docs/PLAN.md section 6): family sorts out who buys what in their own chat.
const subtitle =
  "Looking for a gift idea? These are CDs we'd love to have. Share a link in the family chat so nobody buys the same one twice.";
---

<Base title="Wishlist">
  <AlbumListPage
    client:only="react"
    baseUrl={baseUrl}
    section="wishlist"
    title="Wishlist"
    subtitle={subtitle}
    albums={albums}
    share={{ href: `${baseUrl}/wishlist/`, title: "Arthur & Marlou's wishlist", text: "CDs Arthur & Marlou would love to have" }}
    empty="The wishlist is empty right now"
  />
</Base>
